# ==========================================
# RotaMídia - Variáveis de Ambiente (Exemplo)
# Copie este arquivo para .env.local e preencha com suas credenciais reais.
# NUNCA comite o arquivo .env.local no Git!
# ==========================================

# ------------------------------------------
# Autenticação (Clerk)
# Obtenha no painel https://dashboard.clerk.com
# ------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_SEU_CLERK_PUBLISHABLE_KEY_AQUI
CLERK_SECRET_KEY=sk_test_SUA_CLERK_SECRET_KEY_AQUI

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/cadastro
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/admin
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/admin

# ------------------------------------------
# Backend em Tempo Real (Convex)
# Gerado automaticamente ao rodar `npx convex dev`
# Painel: https://dashboard.convex.dev
# ------------------------------------------
CONVEX_DEPLOYMENT=dev:seu-projeto-123

NEXT_PUBLIC_CONVEX_URL=https://seu-projeto-123.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://seu-projeto-123.convex.site

# ------------------------------------------
# Envio de E-mails Transacionais (Brevo API / SMTP)
# Configure BREVO_API_KEY diretamente no Convex:
# `npx convex env set BREVO_API_KEY "sua_chave_brevo_aqui"`
# `npx convex env set SENDER_EMAIL seuemail@exemplo.com`
# ------------------------------------------
# BREVO_API_KEY=xkeysib-sua-chave-aqui
# SENDER_EMAIL=seuemail@exemplo.com
# SENDER_NAME=Eletromidia Campo
